---
import { resolveCanonicalUrl } from "@/lib/seo/helpers/resolveCanonicalUrl";
import { resolveJsonLdSchema } from "@/lib/seo/helpers/resolveJsonLdSchema";
import type { JsonLdSchema } from "@/lib/seo/types/jsonLd";

interface Props {
  schema: JsonLdSchema;
}

const { schema } = Astro.props;
const canonicalUrl = resolveCanonicalUrl({ site: Astro.site, url: Astro.url });
const siteUrl = Astro.site ? new URL("./", Astro.site).toString() : new URL("/", Astro.url.origin).toString();

const resolvedSchema = resolveJsonLdSchema({ schema, canonicalUrl, siteUrl });
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(resolvedSchema)} />
