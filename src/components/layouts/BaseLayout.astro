---
import "@/styles/global.css";
import A from "@/components/html/{A}/A.astro";
import Body from "@/components/html/{Body}/Body.astro";
import Footer from "@/components/html/{Footer}/Footer.astro";
import Head from "@/components/html/{Head}/Head.astro";
import Header from "@/components/html/{Header}/Header.astro";
import Html from "@/components/html/{Html}/Html.astro";
import Link from "@/components/html/{Link}/Link.astro";
import Main from "@/components/html/{Main}/Main.astro";
import Meta from "@/components/html/{Meta}/Meta.astro";
import Nav from "@/components/html/{Nav}/Nav.astro";
import P from "@/components/html/{P}/P.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import Seo from "@/components/seo/Seo.astro";
import { resolvePageId } from "@/lib/astro/helpers/resolvePageId";
import type { JsonLdSchema } from "@/lib/seo/types/jsonLd";
import type { SeoMeta } from "@/lib/seo/types/seo";

interface Props {
  pageId?: string;
  title?: string;
  description?: string;
  seo?: Partial<SeoMeta>;
  jsonLd?: JsonLdSchema | JsonLdSchema[];
}

const {
  pageId,
  title = "Movie App",
  description = "Astro Movie Application",
  seo,
  jsonLd,
} = Astro.props;

const astro = Astro;
const resolvedPageId = resolvePageId({ astro, pageId });
const jsonLdEntries = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

---

<!doctype html>
<Html lang="en">
  <Head>
    <Meta charset="utf-8" />
    <Link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Meta name="generator" content={Astro.generator} />
    <Seo
      title={seo?.title ?? title}
      description={seo?.description ?? description}
      canonicalPath={seo?.canonicalPath}
      robots={seo?.robots}
      openGraph={seo?.openGraph}
      twitter={seo?.twitter}
    />
    {jsonLdEntries.map((schema) => (
      <JsonLd schema={schema} />
    ))}
  </Head>
  <Body>
    <Header>
      <Nav>
        <A href="/">Home</A>
        <A href="/content">Content</A>
        <A href="/example">Example</A>
        <A href="/themes">Themes</A>
      </Nav>
    </Header>

    <Main id={resolvedPageId}>
      <slot />
    </Main>

    <Footer>
      <P>&copy; {new Date().getFullYear()} Movie App</P>
    </Footer>
  </Body>
</Html>