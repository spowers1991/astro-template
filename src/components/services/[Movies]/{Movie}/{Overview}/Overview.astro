---
import Section from "@/components/html/{Section}/Section.astro";
import H2 from "@/components/html/{H2}/H2.astro";
import P from "@/components/html/{P}/P.astro";
import { portableTextToString } from "@/lib/sanity/helpers/portableTextToString";
import type { PortableTextBlock } from "@portabletext/types";

interface Props {
  overview?: PortableTextBlock[] | string | unknown;
}

const { overview } = Astro.props;
const overviewText = portableTextToString(overview);
---

{overviewText && (
  <Section>
    <H2>Overview</H2>
    <P>{overviewText}</P>
  </Section>
)}
