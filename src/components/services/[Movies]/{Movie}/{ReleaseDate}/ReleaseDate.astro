---
import P from "@/components/html/{P}/P.astro";
import Section from "@/components/html/{Section}/Section.astro";

interface Props {
  releaseDate?: string;
}

const { releaseDate } = Astro.props;
---

{releaseDate && (
  <Section class="movie-release-date">
    <P>
      <strong>Release Date:</strong> {new Date(releaseDate).toLocaleDateString()}
    </P>
  </Section>
)}
