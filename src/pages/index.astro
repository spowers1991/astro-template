---

import { getMovies } from "@/services/[Movies]/queries/getMovies";
import { getPersons } from "@/services/[Persons]/queries/getPersons";
import type { Person as Person} from "@/services/[Persons]/{Person}/types/Person";
import type { Movie as Movie } from "@/services/[Movies]/{Movie}/types/Movie";
import BaseLayout from "@/components/layouts/BaseLayout.astro";
import Movies from "@/components/services/[Movies]/Movies.astro";
import { envEnabled } from "@/lib/sanity/helpers/envEnabled";

const sanityEnabled = envEnabled();
const movies = sanityEnabled ? await getMovies() as Movie[] : [];
const persons = sanityEnabled ? await getPersons() as Person[] : [];

const sanityData = { movies, persons };
const title = "Movie App";
const description = "Browse movie details, casts, crews, and release information.";

---

<BaseLayout
  pageId="page-home"
  title={title}
  description={description}
  jsonLd={[
    { "@type": "WebSite", name: title, description },
    { "@type": "WebPage", name: title, description },
  ]}
>
    <Movies data={sanityData} />
</BaseLayout>
