---

import { getMovies } from "@/services/[Movies]/queries/getMovies";
import { getPersons } from "@/services/[Persons]/queries/getPersons";
import type { Person as PersonType } from "@/services/[Persons]/{Person}/types/Person";
import type { Movie as MovieType } from "@/services/[Movies]/{Movie}/types/Movie";
import BaseLayout from "@/components/layouts/BaseLayout.astro";
import Movies from "@/components/services/[Movies]/Movies.astro";

const hasSanityConfig = Boolean(
  import.meta.env.PUBLIC_SANITY_PROJECT_ID && import.meta.env.PUBLIC_SANITY_DATASET,
);
const movies = hasSanityConfig ? await getMovies() as MovieType[] : [];
const persons = hasSanityConfig ? await getPersons() as PersonType[] : [];

const sanityData = { movies, persons };

---

<BaseLayout title="Movie App">
    <Movies data={sanityData} />
</BaseLayout>
