---

import type { Person as PersonType } from "@/services/[Persons]/{Person}/types/Person";
import type { Movie as MovieType } from "@/services/[Movies]/{Movie}/types/Movie";
import { getMovies } from "@/services/[Movies]/queries/getMovies";
import BaseLayout from "@/components/layouts/BaseLayout.astro";
import Movie from "@/components/services/[Movies]/{Movie}/Movie.astro";
import { getPersons } from "@/services/[Persons]/queries/getPersons";
import { envEnabled } from "@/lib/sanity/helpers/envEnabled";
import { portableTextToString } from "@/lib/sanity/helpers/portableTextToString";
import { safeImageUrl } from "@/lib/sanity/helpers/image";

export async function getStaticPaths() {
  if (!envEnabled()) {
    return [];
  }
  const movies = await getMovies() as MovieType[];
  const persons = await getPersons() as PersonType[];

  return movies.map((movie) => ({
    params: { slug: movie.slug.current },
    props: { sanityData: { movie, persons } },
  }));
}

const { sanityData } = Astro.props;
const movie = sanityData.movie as MovieType;
const title = movie.title || movie.name;
const description = portableTextToString(movie.overview) || `Details about ${title}.`;
const socialImage = safeImageUrl(movie.poster) || undefined;

---

<BaseLayout
  pageId="page-movies"
  title={title}
  description={description}
  seo={{
    canonicalPath: `/movies/${movie.slug.current}/`,
    openGraph: {
      type: "website",
      image: socialImage,
    },
    twitter: {
      image: socialImage,
    },
  }}
  jsonLd={[
    { "@type": "WebPage", name: title, description },
    {
      "@type": "Movie",
      name: title,
      description,
      datePublished: movie.releaseDate,
      image: socialImage,
    },
  ]}
>
  <Movie data={sanityData} />
</BaseLayout>
