---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/components/layouts/BaseLayout.astro";

const posts = await Promise.all(
  (await getCollection("posts")).map(async (post) => ({
    post,
    Content: (await render(post)).Content,
  })),
);
---

<BaseLayout title="Content collection">
  <section class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-3xl font-bold">Content collection</h1>
    {posts.map(({ post, Content }) => (
      <article class="mt-8 rounded border border-slate-700 p-6">
        <h2 class="text-xl font-semibold">{post.data.title}</h2>
        <p class="mt-2 text-slate-300">{post.data.description}</p>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString()}
        </time>
        <div class="mt-4">
          <Content />
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
